VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SITE_URL="https://your-public-site.example"
# Generate from OPAQUE_SERVER_SETUP via:
# npx @serenity-kit/opaque@latest get-server-public-key "<server setup string>"
VITE_OPAQUE_SERVER_STATIC_PUBLIC_KEY="your-opaque-server-static-public-key"
AUTH_RECOVERY_CODE_PEPPER="generate-a-long-random-server-secret"

# Server-only Edge Function secrets. Hosted Supabase Edge Functions allow
# implicit TLS on port 465; ports 25 and 587 are not supported.
SMTP_HOST="smtp.your-provider.example"
SMTP_PORT="465"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="set-only-as-a-supabase-function-secret"
SMTP_FROM="noreply@your-domain.example"
SMTP_SENDER_NAME="Singra Vault"

# Local E2E/runtime UI flag only. Never put passwords in VITE_* variables.
VITE_DEV_TEST_ACCOUNT_UI="false"

# Local dev test account provisioning for npm run dev / npm run tauri:dev.
# Keep real values only in .env.local. This script creates/updates a normal Supabase user.
SINGRA_DEV_TEST_ACCOUNT_ENABLED="false"
SINGRA_DEV_TEST_EMAIL=""
SINGRA_DEV_TEST_PASSWORD=""
SINGRA_DEV_TEST_MASTER_PASSWORD=""
SINGRA_DEV_TEST_CREATE_USER="false"
SINGRA_DEV_TEST_AUTO_CONFIRM="false"
SINGRA_DEV_TEST_RESET_VAULT="false"
SINGRA_DEV_TEST_GRANT_ADMIN="false"
SUPABASE_SERVICE_ROLE_KEY=""
